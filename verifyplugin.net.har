          "content": {
            "size": 26554,
            "mimeType": "text/html",
            "text": "\n<!-- Premium App Store Detail View -->\n<div class=\"h-full overflow-y-auto bg-white dark:bg-gray-950 relative\" x-data=\"{ showFullDescription: false }\">\n\n        <!-- Subtle Decorative Background - Contained in View -->\n    <div class=\"absolute top-0 left-0 right-0 h-80 overflow-hidden pointer-events-none z-0\">\n        <img src=\"assets/img/app_images/bW5tfmobile.png\"\n             alt=\"\"\n             class=\"w-full h-full object-cover blur-sm opacity-40 scale-110\" />\n        <!-- Gradient fade to ensure text readability -->\n        <div class=\"absolute inset-0 bg-gradient-to-b from-white/20 via-white/50 to-white dark:from-gray-950/20 dark:via-gray-950/50 dark:to-gray-950\"></div>\n        <div class=\"absolute inset-0 bg-gradient-to-b from-transparent via-transparent via-70% to-white dark:to-gray-950\"></div>\n    </div>\n    \n    <!-- Compact Hero Section -->\n    <div class=\"relative z-10\">\n        <!-- Content -->\n        <div class=\"relative px-4 pt-4 pb-3\">\n            <div class=\"flex gap-4 items-start\">\n                <!-- App Icon - Smaller, More Refined -->\n                <div class=\"relative flex-shrink-0\">\n                    <div class=\"w-24 h-24 rounded-[1.4rem] shadow-xl shadow-black/20 dark:shadow-black/40 overflow-hidden border-2 border-white/50 dark:border-gray-800/50\">\n                        <img src=\"assets/img/app_images/bW5tfmobile.png\"\n                             alt=\"FC Mobile\"\n                             class=\"w-full h-full object-cover\" />\n                    </div>\n                                        <div class=\"absolute -top-1.5 -right-1.5\">\n                        <span class=\"inline-flex items-center px-2 py-0.5 rounded-full text-[9px] font-bold text-white shadow-lg uppercase tracking-wide\"\n                              style=\"background: #9333ea;\">\n                            Mod                        </span>\n                    </div>\n                                    </div>\n\n                <!-- App Info -->\n                <div class=\"flex-1 min-w-0 pt-1\">\n                    <h1 class=\"text-xl font-bold text-gray-900 dark:text-white leading-tight mb-0.5 line-clamp-2\">\n                        FC Mobile                    </h1>\n                    <p class=\"text-sm text-gray-500 dark:text-gray-400 mb-2\">\n                        Games                    </p>\n\n                    <!-- Compact Stats Row -->\n                    <div class=\"flex items-center gap-3 text-xs text-gray-600 dark:text-gray-400\">\n                        <!-- Rating -->\n                        <div class=\"flex items-center gap-1\">\n                            <svg class=\"w-3.5 h-3.5 text-yellow-400 fill-current\" viewBox=\"0 0 20 20\">\n                                <path d=\"M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z\" />\n                            </svg>\n                            <span class=\"font-semibold text-gray-900 dark:text-white\">5.0</span>\n                        </div>\n\n                        <span class=\"text-gray-300 dark:text-gray-700\">•</span>\n\n                        <!-- Downloads -->\n                        <div class=\"flex items-center gap-1\">\n                            <svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4\" />\n                            </svg>\n                            <span>5K+</span>\n                        </div>\n\n                        <span class=\"text-gray-300 dark:text-gray-700\">•</span>\n\n                        <!-- Size -->\n                        <span>109MB</span>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Download Button - Refined -->\n            <button onclick=\"if(window.currentAppData) { window.dispatchEvent(new CustomEvent('start-download', { detail: window.currentAppData })); }\"\n                    class=\"w-full mt-4 px-5 py-3 bg-[var(--accent-color)] hover:bg-[var(--accent-color)]/90 text-white font-semibold text-base rounded-xl shadow-md hover:shadow-lg transition-all duration-200 active:scale-[0.98]\">\n                Download            </button>\n        </div>\n    </div>\n\n    <!-- Divider -->\n    <div class=\"h-2 relative z-10\"></div>\n\n    <!-- What's New Section -->\n        <div class=\"px-4 py-4 border-b border-gray-100 dark:border-gray-800 relative z-10\">\n        <div class=\"flex items-center justify-between mb-2\">\n            <h2 class=\"text-base font-semibold text-gray-900 dark:text-white\">What's New</h2>\n            <span class=\"text-xs text-gray-500 dark:text-gray-400 font-mono\">Version 1.0</span>\n        </div>\n        <p class=\"text-sm text-gray-600 dark:text-gray-400 leading-relaxed\">\n            Latest version with performance improvements and bug fixes.\n        </p>\n    </div>\n    \n    <!-- Description Section - Collapsible -->\n    <div class=\"px-4 py-4 border-b border-gray-100 dark:border-gray-800 relative z-10 bg-white dark:bg-gray-950\">\n        <h2 class=\"text-base font-semibold text-gray-900 dark:text-white mb-3\">About</h2>\n        <div class=\"relative\">\n            <div :class=\"showFullDescription ? '' : 'max-h-32 overflow-hidden'\"\n                 class=\"rich-text\">\n                <p>Unlimited Coins and FC Points</p>            </div>\n\n            <!-- Gradient Fade for Long Content -->\n            <div x-show=\"!showFullDescription\"\n                 class=\"absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-white dark:from-gray-950 to-transparent pointer-events-none\"></div>\n        </div>\n\n        <!-- Read More Button -->\n        <button @click=\"showFullDescription = !showFullDescription\"\n                class=\"mt-3 text-sm font-semibold text-[var(--accent-color)] hover:text-[var(--accent-color)]/80 transition-colors\">\n            <span x-text=\"showFullDescription ? 'Show Less' : 'Read More'\">Read More</span>\n        </button>\n    </div>\n\n    <!-- Information Section -->\n    <div class=\"px-4 py-4 border-b border-gray-100 dark:border-gray-800 relative z-10 bg-white dark:bg-gray-950\">\n        <h2 class=\"text-base font-semibold text-gray-900 dark:text-white mb-3\">Information</h2>\n        <div class=\"space-y-3\">\n            <!-- Version -->\n            <div class=\"flex items-center justify-between\">\n                <span class=\"text-sm text-gray-500 dark:text-gray-400\">Version</span>\n                <span class=\"text-sm font-medium text-gray-900 dark:text-white font-mono\">1.0</span>\n            </div>\n\n            <!-- Size -->\n            <div class=\"flex items-center justify-between\">\n                <span class=\"text-sm text-gray-500 dark:text-gray-400\">Size</span>\n                <span class=\"text-sm font-medium text-gray-900 dark:text-white\">109MB</span>\n            </div>\n\n            <!-- Category -->\n            <div class=\"flex items-center justify-between\">\n                <span class=\"text-sm text-gray-500 dark:text-gray-400\">Category</span>\n                <span class=\"text-sm font-medium text-gray-900 dark:text-white\">Games</span>\n            </div>\n\n            <!-- Rating -->\n            <div class=\"flex items-center justify-between\">\n                <span class=\"text-sm text-gray-500 dark:text-gray-400\">Rating</span>\n                <div class=\"flex items-center gap-1.5\">\n                    <div class=\"flex items-center gap-0.5\">\n                                                <svg class=\"w-3 h-3 text-yellow-400 fill-current\" viewBox=\"0 0 20 20\">\n                            <path d=\"M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z\" />\n                        </svg>\n                                                <svg class=\"w-3 h-3 text-yellow-400 fill-current\" viewBox=\"0 0 20 20\">\n                            <path d=\"M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z\" />\n                        </svg>\n                                                <svg class=\"w-3 h-3 text-yellow-400 fill-current\" viewBox=\"0 0 20 20\">\n                            <path d=\"M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z\" />\n                        </svg>\n                                                <svg class=\"w-3 h-3 text-yellow-400 fill-current\" viewBox=\"0 0 20 20\">\n                            <path d=\"M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z\" />\n                        </svg>\n                                                <svg class=\"w-3 h-3 text-yellow-400 fill-current\" viewBox=\"0 0 20 20\">\n                            <path d=\"M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z\" />\n                        </svg>\n                                            </div>\n                    <span class=\"text-sm font-semibold text-gray-900 dark:text-white\">5.0</span>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <!-- You Might Also Like -->\n        <div class=\"px-4 py-4 relative z-10 bg-white dark:bg-gray-950\">\n        <h2 class=\"text-base font-semibold text-gray-900 dark:text-white mb-4\">You Might Also Like</h2>\n\n        <!-- Horizontal Scroll Grid -->\n        <div class=\"overflow-x-auto -mx-4 px-4 scrollbar-hide\">\n            <div class=\"flex gap-4 pb-2\">\n                                <a @click.prevent=\"loadAppDetail(58)\"\n                   href=\"/delta-executor\"\n                   class=\"flex-shrink-0 w-36 block group cursor-pointer\">\n\n                    <!-- Card Container -->\n                    <div class=\"bg-white dark:bg-gray-900 rounded-2xl p-3 shadow-sm group-hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-gray-800 group-hover:scale-[1.02]\">\n                        <!-- App Icon -->\n                        <div class=\"relative mb-3\">\n                            <div class=\"aspect-square rounded-xl overflow-hidden bg-gray-100 dark:bg-gray-800\">\n                                <img src=\"assets/img/app_images/6F2fdeltaicon.jpg\"\n                                     alt=\"Delta Executor\"\n                                     class=\"w-full h-full object-cover\" />\n                            </div>\n\n                            <!-- Badge if exists -->\n                                                        <div class=\"absolute -top-1 -right-1\">\n                                <span class=\"inline-flex items-center px-1.5 py-0.5 rounded-md text-[9px] font-bold text-white shadow-lg uppercase tracking-wider\" style=\"background: #9333ea;\">\n                                    Game                                </span>\n                            </div>\n                                                    </div>\n\n                        <!-- App Name -->\n                        <h3 class=\"text-xs font-semibold text-gray-900 dark:text-white line-clamp-2 leading-tight mb-2 min-h-[2rem]\">\n                            Delta Executor                        </h3>\n\n                        <!-- Meta Info Row -->\n                        <div class=\"flex items-center justify-between gap-2\">\n                                                        <div class=\"flex items-center gap-1\">\n                                <svg class=\"w-3 h-3 text-yellow-400 fill-current\" viewBox=\"0 0 20 20\">\n                                    <path d=\"M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z\" />\n                                </svg>\n                                <span class=\"text-[10px] font-bold text-gray-700 dark:text-gray-300\">5.0</span>\n                            </div>\n                            \n                            <!-- GET Button -->\n                            <button class=\"px-3 py-1 rounded-full text-[10px] font-bold text-white group-hover:scale-105 transition-transform duration-200\" style=\"background: #9333ea;\">\n                                GET\n                            </button>\n                        </div>\n                    </div>\n                </a>\n                                <a @click.prevent=\"loadAppDetail(59)\"\n                   href=\"/bitlife\"\n                   class=\"flex-shrink-0 w-36 block group cursor-pointer\">\n\n                    <!-- Card Container -->\n                    <div class=\"bg-white dark:bg-gray-900 rounded-2xl p-3 shadow-sm group-hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-gray-800 group-hover:scale-[1.02]\">\n                        <!-- App Icon -->\n                        <div class=\"relative mb-3\">\n                            <div class=\"aspect-square rounded-xl overflow-hidden bg-gray-100 dark:bg-gray-800\">\n                                <img src=\"assets/img/app_images/E8Hnbitlifeicon.webp\"\n                                     alt=\"BitLife\"\n                                     class=\"w-full h-full object-cover\" />\n                            </div>\n\n                            <!-- Badge if exists -->\n                                                        <div class=\"absolute -top-1 -right-1\">\n                                <span class=\"inline-flex items-center px-1.5 py-0.5 rounded-md text-[9px] font-bold text-white shadow-lg uppercase tracking-wider\" style=\"background: #9333ea;\">\n                                    Mod                                </span>\n                            </div>\n                                                    </div>\n\n                        <!-- App Name -->\n                        <h3 class=\"text-xs font-semibold text-gray-900 dark:text-white line-clamp-2 leading-tight mb-2 min-h-[2rem]\">\n                            BitLife                        </h3>\n\n                        <!-- Meta Info Row -->\n                        <div class=\"flex items-center justify-between gap-2\">\n                                                        <div class=\"flex items-center gap-1\">\n                                <svg class=\"w-3 h-3 text-yellow-400 fill-current\" viewBox=\"0 0 20 20\">\n                                    <path d=\"M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z\" />\n                                </svg>\n                                <span class=\"text-[10px] font-bold text-gray-700 dark:text-gray-300\">5.0</span>\n                            </div>\n                            \n                            <!-- GET Button -->\n                            <button class=\"px-3 py-1 rounded-full text-[10px] font-bold text-white group-hover:scale-105 transition-transform duration-200\" style=\"background: #9333ea;\">\n                                GET\n                            </button>\n                        </div>\n                    </div>\n                </a>\n                                <a @click.prevent=\"loadAppDetail(60)\"\n                   href=\"/pokemon-go\"\n                   class=\"flex-shrink-0 w-36 block group cursor-pointer\">\n\n                    <!-- Card Container -->\n                    <div class=\"bg-white dark:bg-gray-900 rounded-2xl p-3 shadow-sm group-hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-gray-800 group-hover:scale-[1.02]\">\n                        <!-- App Icon -->\n                        <div class=\"relative mb-3\">\n                            <div class=\"aspect-square rounded-xl overflow-hidden bg-gray-100 dark:bg-gray-800\">\n                                <img src=\"assets/img/app_images/ndIEpokemongo.png\"\n                                     alt=\"Pokemon Go\"\n                                     class=\"w-full h-full object-cover\" />\n                            </div>\n\n                            <!-- Badge if exists -->\n                                                        <div class=\"absolute -top-1 -right-1\">\n                                <span class=\"inline-flex items-center px-1.5 py-0.5 rounded-md text-[9px] font-bold text-white shadow-lg uppercase tracking-wider\" style=\"background: #9333ea;\">\n                                    Game                                </span>\n                            </div>\n                                                    </div>\n\n                        <!-- App Name -->\n                        <h3 class=\"text-xs font-semibold text-gray-900 dark:text-white line-clamp-2 leading-tight mb-2 min-h-[2rem]\">\n                            Pokemon Go                        </h3>\n\n                        <!-- Meta Info Row -->\n                        <div class=\"flex items-center justify-between gap-2\">\n                                                        <div class=\"flex items-center gap-1\">\n                                <svg class=\"w-3 h-3 text-yellow-400 fill-current\" viewBox=\"0 0 20 20\">\n                                    <path d=\"M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z\" />\n                                </svg>\n                                <span class=\"text-[10px] font-bold text-gray-700 dark:text-gray-300\">5.0</span>\n                            </div>\n                            \n                            <!-- GET Button -->\n                            <button class=\"px-3 py-1 rounded-full text-[10px] font-bold text-white group-hover:scale-105 transition-transform duration-200\" style=\"background: #9333ea;\">\n                                GET\n                            </button>\n                        </div>\n                    </div>\n                </a>\n                                <a @click.prevent=\"loadAppDetail(61)\"\n                   href=\"/steal-an-egg\"\n                   class=\"flex-shrink-0 w-36 block group cursor-pointer\">\n\n                    <!-- Card Container -->\n                    <div class=\"bg-white dark:bg-gray-900 rounded-2xl p-3 shadow-sm group-hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-gray-800 group-hover:scale-[1.02]\">\n                        <!-- App Icon -->\n                        <div class=\"relative mb-3\">\n                            <div class=\"aspect-square rounded-xl overflow-hidden bg-gray-100 dark:bg-gray-800\">\n                                <img src=\"assets/img/app_images/xCvOegg.png\"\n                                     alt=\"Steal an Egg\"\n                                     class=\"w-full h-full object-cover\" />\n                            </div>\n\n                            <!-- Badge if exists -->\n                                                        <div class=\"absolute -top-1 -right-1\">\n                                <span class=\"inline-flex items-center px-1.5 py-0.5 rounded-md text-[9px] font-bold text-white shadow-lg uppercase tracking-wider\" style=\"background: #9333ea;\">\n                                    Scrip                                </span>\n                            </div>\n                                                    </div>\n\n                        <!-- App Name -->\n                        <h3 