            "text": "<meta name=\"viewport\" content=\"width=device-width\">\n<meta name=\"csrf-token\" content=\"eFl3GhaskZgboHnZrJIoEW5pnCQM6HieKw8teTjZ\">\n<meta name=\"robots\" content=\"noindex, nofollow\">\n<meta name=\"domain-check\" content=\"true\">\n\n    <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap\">\n\n    <link href=\"https://cdn.jsdelivr.net/npm/fastbootstrap@2.2.0/dist/css/fastbootstrap.min.css\" rel=\"stylesheet\">\n    <link href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css\" rel=\"stylesheet\">\n\n<style>\n    @import url(https://fonts.googleapis.com/css?family=Source+Sans+Pro:400,700,300,200);.lockerBackground{position:fixed;top:0;left:0;width:100%;height:100%;background-color:#000;opacity:.8;display:none;z-index:9999998}.lockerPopup{height:auto;z-index:9999999;top:50%;left:50%;position:fixed}.lockerPopup .header{text-align:center;font-weight:700;font-family:'Source Sans Pro',sans-serif}.lockerPopup .content{text-align:center;font-family:'Source Sans Pro',sans-serif}.lockerPopup .footer{font-family:'Source Sans Pro',sans-serif;text-align:center}.lc-checks{list-style:none;margin:0;position:relative;font-family:'Source Sans Pro',sans-serif}.lc-checks li{position:relative;cursor:hand;text-align:center;display:block}.animated{-webkit-animation-duration:1.5s;animation-duration:1.5s;-webkit-animation-fill-mode:both;animation-fill-mode:both}@-webkit-keyframes bounceInDown{0%{opacity:0;-webkit-transform:translate(-50%,-2000px)}60%{opacity:1;-webkit-transform:translateY(-50%,-53%)}80%{-webkit-transform:translateY(-50%,-51%)}100%{-webkit-transform:translate(-50%,-50%)}}@keyframes bounceInDown{0%{opacity:0;transform:translate(-50%,-2000px)}60%{opacity:1;transform:translate(-50%,-53%)}80%{transform:translate(-50%,-51%)}100%{transform:translate(-50%,-50%)}}.bounceInDown{-webkit-animation-name:bounceInDown;animation-name:bounceInDown}:root{--body-bg:#e0e8ef;--border-color:#746bf2;--container-bg:#0f2138;--offer-bg:#1a2a4fe0;--text-color:white;--bs-link-color:white;--completion-color:#746bf2}body{padding:0;margin:0;color:var(--text-color);font-family:Poppins,sans-serif;overflow-x:hidden;background-color:inherit}.lockerPopup{background-color:var(--body-bg)}.Contentlocker{position:relative;width:100%;min-height:108vh}.vector{width:680px;margin:auto;background:var(--border-color);padding:.3rem;border-radius:1rem}.vectorcontainer{background-color:var(--container-bg);width:100%;height:100%;border-radius:.7rem}.app{background-color:var(--offer-bg);width:90%}.content-title{display:flex;justify-content:center;align-items:center;margin:0}.parallelogram{position:relative;width:50%;margin:auto;background:linear-gradient(to right,#0f213800,#54a3fd7e,#7c18e746,#0f213800);transform:skew(48deg);display:flex;align-items:center;justify-content:center;margin-bottom:.5rem;height:50px}.content{transform:skew(-48deg);font-size:1em;font-weight:700;text-align:center;display:flex;align-items:center}.app{box-shadow:rgba(0,0,0,.09) 0 2px 1px,rgba(0,0,0,.09) 0 4px 2px,rgba(0,0,0,.09) 0 8px 4px,rgba(0,0,0,.09) 0 16px 8px,rgba(0,0,0,.09) 0 32px 16px!important}.lock-container{display:flex;flex-direction:column;align-items:center;height:auto;z-index:9999999;top:50%;left:50%;position:fixed;transform:translate(-50%,-50%) scale(1)}.lock-head{width:200px;height:100px;border-top-left-radius:50% 100%;border-top-right-radius:50% 100%;border:12px solid #746bf2}.lock-bg{width:100%;height:100%;background-color:transparent;border-top-left-radius:50% 100%;border-top-right-radius:50% 100%}.lock-body{width:100%;margin-top:-.8rem}.app-description{width:75%}.action-btn{background:linear-gradient(to right,#54a3fd7e,#7c18e746);border-radius:.3rem;cursor:pointer;width:15%;box-shadow:rgba(0,0,0,.09) 0 2px 1px,rgba(0,0,0,.09) 0 4px 2px,rgba(0,0,0,.09) 0 8px 4px,rgba(0,0,0,.09) 0 16px 8px,rgba(0,0,0,.09) 0 32px 16px!important}.rotate-90{transform:rotate(90deg);transition:transform .3s ease;padding-top:1.25rem}.hero-shadow{height:150px}.hero{height:150px;background-size:120%;opacity:.1;position:absolute;left:0;right:0;pointer-events:none;transform:rotate(-5deg);z-index:1;transform-origin:18px center;width:100%}.overlay{position:absolute;bottom:0;left:0;z-index:10;background:linear-gradient(180deg,transparent,#0f213894,#0f2138);height:100px;width:100%;visibility:hidden}.hero-content{z-index:10000}.checker{background:var(--completion-color)}.container{max-width:none!important}a{color:inherit}a:hover{text-decoration:none}\n\n    :root {\n        --custom-background-opacity: 0.8;\n    }\n\n    /* overrides */\n\n    .lockerBackground {\n        opacity: var(--custom-background-opacity);\n    }\n</style>\n\n\n    <style>\n        :root {\n            --custom-background-color: #0F2138;\n            --custom-foreground-color: #FFFFFF;\n        }\n\n        /* overrides */\n        .hero {\n            background-image: url(https://verifyplugin.net/cdn/img/cl/desktop/briefcase/header-bg.webp?v=58e765a9) !important;\n        }\n\n        body {\n            color: var(--custom-foreground-color) !important;\n        }\n\n        .vectorcontainer {\n            background-color: var(--custom-background-color) !important;\n        }\n\n    </style>\n\n\n<style class=\"custom-custom-css\" id=\"custom-custom-css\">\n    \n\n    \n</style>\n\n<div id=\"contentLockerBackground\" class=\"lockerBackground\"></div>\n<div id=\"contentLocker\" class=\"lockerPopup animated bounceInDown\">\n        <div class=\"header\">\n            </div>\n                    <section class=\"Contentlocker\">\n    <div class=\"lock-container\" style=\"margin-top: 0.5rem;\">\n        <div class=\"lock-head\">\n            <div class=\"lock-bg\"></div>\n        </div>\n        <div class=\"lock-body\">\n            <section class=\"vector shadow-lg\">\n                <sect